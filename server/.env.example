# Copy this file to .env and fill in your values — never commit .env

# MongoDB connection string (Atlas or local)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/devloop?retryWrites=true&w=majority

# Dedicated test database — used by Jest integration tests only
TEST_MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/devloop-test?retryWrites=true&w=majority

# JWT signing secret — use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=replace_with_a_long_random_secret

# Server port
PORT=4000

# Set to 'production' to enable Secure cookie flag
NODE_ENV=development
